  "info": {
    "_postman_id": "34c84780-184a-5332-b4f4-26db9c3be5d9",
    "name": "MediScan AI - Compléments (étapes 13 à 19)",
    "description": "Scan et OCR, alertes, rappels, notifications, tableau de bord médecin, partages. Prérequis : données de démonstration rechargées, Tesseract installé. Lancer avec --working-dir postman (pour le fichier image).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "motDePasseDemo",
      "value": "MediScan2026!"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Exigence du cahier des charges : réponse en moins de 2 s (sauf l'analyse OCR, testée à part)",
          "if (!pm.info.requestName.includes(\"OCR\")) {",
          "    pm.test(\"[global] Réponse en moins de 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
          "}",
          "const type = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (type.includes(\"application/json\")) {",
          "    pm.test(\"[global] Aucun hash BCrypt exposé\", () => pm.expect(pm.response.text()).to.not.match(/\\$2[aby]\\$\\d{2}\\$/));",
          "}"
        ]
      }
    }
  ],
