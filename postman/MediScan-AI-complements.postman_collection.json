    {
      "name": "12 - Scan : envoi, analyse IA, alertes, suppression",
      "item": [
        {
          "name": "Envoyer une photo de Doliprane (OCR)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patient/scans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patient",
                "scans"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jetonMarc}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "fichiers/boite-doliprane.jpg"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.test(\"Médicament reconnu : Doliprane\", () => { pm.expect(s.statut).to.eql(\"TERMINE\"); pm.expect(s.medicament.nomCommercial).to.eql(\"Doliprane\"); });",
                  "pm.test(\"Lot et expiration lus\", () => { pm.expect(s.numeroLot).to.eql(\"24B117\"); pm.expect(s.dateExpiration).to.eql(\"2028-03-31\"); });",
                  "pm.test(\"Analyse en moins de 5 s (cahier des charges)\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.collectionVariables.set(\"scanId\", s.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Alertes du scan : interaction avec la warfarine",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patient/scans/{{scanId}}/alertes",
